{
  "name": "local-preview",
  "displayName": "Local Preview",
  "version": "0.1.1",
  "description": "Opens pages served on this computer's loopback address in a browser and reads back the tab's title and address.",
  "icon": "icon.svg",
  "engines": { "cage": ">=0.1.8" },
  "kind": "host",
  "platforms": ["windows"],
  "permissions": ["network"],
  "categories": ["developer"],
  "contributes": {
    "mcpServers": [{ "id": "preview", "command": ["powershell.exe", "-NoLogo", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "server.ps1"] }]
  }
}
