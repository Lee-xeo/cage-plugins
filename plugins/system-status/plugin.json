{
  "name": "system-status",
  "displayName": "System Status",
  "version": "0.2.1",
  "description": "Shows real-time CPU, memory, disk and network telemetry of the environment in a draggable translucent floating overlay and as a tool for Claude.",
  "icon": "icon.svg",
  "engines": { "cage": ">=0.2.1" },
  "kind": "guest",
  "permissions": [],
  "categories": ["system", "example"],
  "contributes": {
    "mcpServers": [
      { "id": "status", "command": ["python3", "server.py"] }
    ],
    "views": [
      {
        "id": "status",
        "title": "System Status",
        "icon": "icon.svg",
        "entry": "view/index.html",
        "server": "status",
        "presentation": "floating",
        "width": 316,
        "height": 286
      }
    ]
  }
}
