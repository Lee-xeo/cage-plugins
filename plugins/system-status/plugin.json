{
  "name": "system-status",
  "displayName": "System Status",
  "version": "0.1.1",
  "description": "Shows processor load, memory and disk use of the environment, to you on a page and to Claude as a tool.",
  "icon": "icon.svg",
  "engines": { "cage": ">=0.1.8" },
