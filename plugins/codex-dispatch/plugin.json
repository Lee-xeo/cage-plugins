{
  "name": "codex-dispatch",
  "displayName": "Codex Dispatch",
  "version": "0.1.1",
  "description": "Delegate a read-only project review to Codex, select a model, and check or cancel the task.",
  "engines": { "cage": ">=0.2.0" },
  "kind": "host",
  "icon": "icon.svg",
  "platforms": ["darwin", "windows"],
  "permissions": ["files", "commands", "network"],
  "categories": ["developer"],
  "contributes": {
    "mcpServers": [
      { "id": "dispatch", "command": ["node", "server.mjs", "${PROJECT_DIR}"] }
    ]
  }
}
