{
  "name": "excel-workbooks",
  "displayName": "Excel Workbooks",
  "version": "0.2.1",
  "description": "Creates, reads and edits Excel workbooks (.xlsx): cells, formulas, formatting, charts, pivot tables and sheets. Microsoft Excel is not needed.",
  "icon": "icon.svg",
  "engines": {
    "cage": ">=0.1.8"
  },
  "kind": "guest",
  "permissions": [],
  "categories": [
    "productivity",
    "files"
  ],
  "contributes": {
    "mcpServers": [
      {
        "id": "excel",
        "command": [
          "python3",
          "launcher.py",
          "--allow-dir",
          "${PROJECT_DIR}"
        ]
      }
    ]
  }
}
