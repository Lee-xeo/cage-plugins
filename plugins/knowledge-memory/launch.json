{
  "name": "knowledge-memory",
  "version": "0.1.2",
  "server": {
    "command": [
      "node",
      "node_modules/@modelcontextprotocol/server-memory/dist/index.js"
    ]
  },
  "dataDirs": [
    "~/.local/share/knowledge-memory"
  ],
  "env": {
    "MEMORY_FILE_PATH": "~/.local/share/knowledge-memory/memory.jsonl"
  },
  "requires": [
    {
      "program": "node",
      "missing": "Node.js is required to run Knowledge Memory."
    }
  ]
}
