{
  "name": "chrome-devtools",
  "version": "0.1.0",
  "toolPrefix": "devtools_",
  "server": {
    "command": [
      "npx",
      "--yes",
      "chrome-devtools-mcp@1.13.0",
      "--headless",
      "--isolated",
      "--executablePath",
      "/usr/bin/chromium",
      "--no-usage-statistics",
      "--no-performance-crux"
    ]
  },
  "env": {
    "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1"
  },
  "requires": [
    {
      "program": "npx",
      "missing": "Node.js (npx) is required to run Chrome DevTools."
    },
    {
      "path": "/usr/bin/chromium",
      "missing": "Chromium (/usr/bin/chromium) is required to run Chrome DevTools. Install it with: sudo apt-get install chromium"
    }
  ]
}
