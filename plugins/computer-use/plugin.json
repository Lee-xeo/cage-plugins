{
  "name": "computer-use",
  "displayName": "Computer Use",
  "version": "0.2.2",
  "description": "Sees and works the apps of this computer in the background, asking the user before each app, without changing the app in front.",
  "kind": "host",
  "engines": {
    "cage": ">=0.1.8"
  },
  "platforms": [
    "darwin"
  ],
  "permissions": [
    "screen",
    "input"
  ],
  "categories": [
    "desktop"
  ],
  "contributes": {
    "mcpServers": [
      {
        "id": "computer-use",
        "command": [
          "python3",
          "server.py"
        ]
      }
    ]
  },
  "icon": "icon.svg"
}
