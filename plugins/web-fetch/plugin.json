{
  "name": "web-fetch",
  "displayName": "Web Fetch",
  "version": "0.1.0",
  "description": "Fetches web pages and converts HTML content to clean Markdown for reading, with pagination and robots.txt support.",
  "icon": "icon.svg",
  "engines": {
    "cage": ">=0.1.8"
  },
  "kind": "guest",
  "permissions": [
    "network"
  ],
  "categories": [
    "network",
    "productivity"
  ],
  "contributes": {
    "mcpServers": [
      {
        "id": "fetch",
        "command": [
          "python3",
          "launcher.py"
        ]
      }
    ]
  }
}
