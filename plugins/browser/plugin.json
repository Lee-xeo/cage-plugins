{
  "name": "browser",
  "displayName": "Browser",
  "version": "0.1.1",
  "description": "Opens web pages in a headless Chromium, reads them as an accessibility snapshot, and clicks, types, fills forms and takes screenshots.",
  "icon": "icon.svg",
  "engines": {
    "cage": ">=0.1.8"
  },
  "kind": "guest",
  "permissions": [
    "network"
  ],
  "categories": [
    "network",
    "developer"
  ],
  "contributes": {
    "mcpServers": [
      {
        "id": "browser",
        "command": [
          "npx",
          "--yes",
          "@playwright/mcp@0.0.86",
          "--headless",
          "--isolated",
          "--browser",
          "chromium",
          "--executable-path",
          "/usr/bin/chromium",
          "--output-dir",
          "output"
        ]
      }
    ]
  }
}
