{
  "version": 1,
  "plugins": [
    {
      "name": "blender",
      "version": "0.1.0",
      "description": "Works with an open Blender: reads the scene, creates and changes objects and materials, runs Python in Blender and captures the viewport. Needs Blender with the included add-on.",
      "permissions": [
        "commands",
        "files",
        "network"
      ],
      "displayName": "Blender",
      "categories": [
        "productivity",
        "desktop"
      ],
      "kind": "host",
      "engines": {
        "cage": ">=0.1.8"
      },
      "contributes": {
        "mcpServers": [
          {
            "id": "blender",
            "command": [
              "uv",
              "run",
              "--no-project",
              "--exclude-newer",
              "2025-10-21T00:00:00Z",
              "--with",
              "blender-mcp==1.3.1",
              "python",
              "server.py"
            ]
          }
        ]
      },
      "runtime": "uv",
      "source": {
        "project": "ahujasid/blender-mcp",
        "version": "1.3.1",
        "license": "MIT",
        "url": "https://github.com/ahujasid/blender-mcp"
      },
      "icon": "https://raw.githubusercontent.com/Lee-xeo/cage-plugins/main/plugins/blender/icon.svg",
      "archive": "https://raw.githubusercontent.com/Lee-xeo/cage-plugins/main/dist/blender-0.1.0.tar.gz",
      "sha256": "78ac56449282f5931bb72f3227880aa5c3b87292ce455eef4cdb42bc2c4b1710",
      "bytes": 18112
    },
