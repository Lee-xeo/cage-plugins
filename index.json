{
  "version": 1,
  "plugins": [
    {
      "name": "blender",
      "version": "0.1.0",
      "description": "Works with an open Blender: reads the scene, creates and changes objects and materials, runs Python in Blender and captures the viewport. Needs Blender with the included add-on.",
      "permissions": [
        "commands",
        "files",
        "network"
      ],
      "displayName": "Blender",
      "categories": [
        "productivity",
        "desktop"
      ],
      "kind": "host",
      "engines": {
        "cage": ">=0.1.8"
      },
      "contributes": {
        "mcpServers": [
          {
            "id": "blender",
            "command": [
              "uv",
              "run",
              "--no-project",
              "--exclude-newer",
              "2025-10-21T00:00:00Z",
              "--with",
              "blender-mcp==1.3.1",
              "python",
              "server.py"
            ]
          }
        ]
      },
      "source": {
        "project": "ahujasid/blender-mcp",
        "version": "1.3.1",
        "license": "MIT",
        "url": "https://github.com/ahujasid/blender-mcp"
      },
      "icon": "https://raw.githubusercontent.com/Lee-xeo/cage-plugins/main/plugins/blender/icon.svg",
      "archive": "https://raw.githubusercontent.com/Lee-xeo/cage-plugins/main/dist/blender-0.1.0.tar.gz",
      "sha256": "78ac56449282f5931bb72f3227880aa5c3b87292ce455eef4cdb42bc2c4b1710",
      "bytes": 18112
    },
    {
      "name": "browser",
      "version": "0.1.0",
      "description": "Opens web pages in a headless Chromium, reads them as an accessibility snapshot, and clicks, types, fills forms and takes screenshots.",
      "permissions": [
        "network"
      ],
      "displayName": "Browser",
      "categories": [
        "network",
        "developer"
      ],
      "kind": "guest",
      "engines": {
        "cage": ">=0.1.8"
      },
      "contributes": {
        "mcpServers": [
          {
            "id": "browser",
            "command": [
              "npx",
              "--yes",
              "@playwright/mcp@0.0.86",
              "--headless",
              "--isolated",
              "--browser",
              "chromium",
              "--executable-path",
              "/usr/bin/chromium",
              "--output-dir",
              "output"
            ]
          }
        ]
      },
      "source": {
        "project": "microsoft/playwright-mcp",
        "version": "0.0.86",
        "license": "Apache-2.0",
        "url": "https://github.com/microsoft/playwright-mcp"
      },
      "icon": "https://raw.githubusercontent.com/Lee-xeo/cage-plugins/main/plugins/browser/icon.svg",
      "archive": "https://raw.githubusercontent.com/Lee-xeo/cage-plugins/main/dist/browser-0.1.0.tar.gz",
      "sha256": "66aa1c65c539df134e74d5a3b14e723b5091f261512592e23620cbfe0124c8d9",
      "bytes": 5859
    },
